{
  "manifest_version": 3,
  "name": "Secure Checker",
  "description": "Quick or detailed security check of the site you're on: missing security headers, risky cookie flags, and HTTPS status.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Secure Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "cookies", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
